# ============================================================================
# dsh-llm-architect 环境变量模板
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会进入仓库。
# 本机只做"控制面"：这些密钥只用于生成云端脚本与发起 SSH/HTTPS 调度。
# ============================================================================

# ---------- HuggingFace（数据下载 / 模型发布） ----------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_USER=your-username
HF_ENDPOINT=https://huggingface.co

# ---------- AutoDL（国内 GPU 租用） ----------
# 在 https://www.autodl.com 控制台 -> API 文档 获取
AUTODL_TOKEN=
AUTODL_ACCOUNT=

# ---------- AWS SageMaker ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SAGEMAKER_ROLE_ARN=arn:aws:iam::000000000000:role/AmazonSageMaker-ExecutionRole
AWS_ECR_IMAGE=

# ---------- 阿里云 PAI（可选） ----------
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_PAI_REGION=cn-hangzhou

# ---------- SSH / 远程 GPU 节点 ----------
SSH_KEY_PATH=C:\Users\you\.ssh\id_rsa
REMOTE_HOST=
REMOTE_USER=root
REMOTE_PORT=22
REMOTE_WORKDIR=/root/llm-training

# ---------- 可选：实验追踪与发布 ----------
WANDB_TOKEN=
GH_TOKEN=
